  "components": [
    {
      "name": "Gold Reserve Button",
      "kind": "button",
      "refersTo": "button-gold",
      "description": "The Reserve action only; the one gold action in a region.",
      "html": "<button class=\"ds-btn-gold\">Reserve a seat <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></button>",
      "css": ".ds-btn-gold{display:inline-flex;align-items:center;gap:10px;min-height:52px;padding:0 24px;border:0;border-radius:14px;background:#f5b841;color:#3a2600;font-family:'Figtree',system-ui,sans-serif;font-weight:600;font-size:17px;box-shadow:0 10px 24px -12px rgb(245 184 65 / 80%);cursor:pointer;transition:transform .15s cubic-bezier(.2,.8,.2,1),background-color .15s}.ds-btn-gold:hover{background:#f7c35e}.ds-btn-gold:active{transform:scale(.97)}.ds-btn-gold:focus-visible{outline:3px solid #0a6fc2;outline-offset:3px}"
    },
    {
      "name": "Indigo Button",
      "kind": "button",
      "refersTo": "button-indigo",
      "description": "Primary non-Reserve action on a white panel; inverts to white in dark mode.",
      "html": "<button class=\"ds-btn-ind\">Show bank details</button>",
      "css": ".ds-btn-ind{min-height:52px;padding:0 24px;border:0;border-radius:14px;background:#0e2766;color:#fff;font-family:'Figtree',system-ui,sans-serif;font-weight:600;font-size:17px;cursor:pointer;transition:transform .15s cubic-bezier(.2,.8,.2,1),background-color .15s}.ds-btn-ind:hover{background:#16378c}.ds-btn-ind:active{transform:scale(.97)}.ds-btn-ind:focus-visible{outline:3px solid #0a6fc2;outline-offset:3px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary and reset actions.",
      "html": "<button class=\"ds-btn-ghost\">Edit event</button>",
      "css": ".ds-btn-ghost{min-height:44px;padding:0 16px;border:0;border-radius:11px;background:none;color:#0d1a3a;box-shadow:inset 0 0 0 1.5px #c9d6e8;font-family:'Figtree',system-ui,sans-serif;font-weight:600;font-size:15px;cursor:pointer}.ds-btn-ghost:hover{box-shadow:inset 0 0 0 1.5px #0a6fc2}.ds-btn-ghost:focus-visible{outline:3px solid #0a6fc2;outline-offset:3px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Labelled 52px field with a blue focus halo.",
      "html": "<div class=\"ds-field\"><label for=\"ds-e\">Email</label><input id=\"ds-e\" type=\"email\" placeholder=\"you@example.com\"></div>",
      "css": ".ds-field label{display:block;font-family:'Figtree',system-ui,sans-serif;font-weight:600;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:#4a5a7a;margin-bottom:7px}.ds-field input{width:100%;height:52px;border-radius:12px;border:1.5px solid #c9d6e8;background:#fff;padding:0 16px;font-size:17px;font-family:'Figtree',system-ui,sans-serif;color:#0d1a3a;transition:border-color .15s,box-shadow .15s}.ds-field input:focus{outline:none;border-color:#0a6fc2;box-shadow:0 0 0 4px rgb(10 111 194 / 18%)}"
    },
    {
      "name": "Panel Card",
      "kind": "card",
      "refersTo": "card-panel",
      "description": "White card on the tinted canvas, one soft blue lift.",
      "html": "<div class=\"ds-panel\"><h3>Your details</h3><p>Fields marked * are required.</p></div>",
      "css": ".ds-panel{background:#fff;border-radius:20px;padding:34px 34px 28px;box-shadow:0 1px 2px rgb(14 39 102 / 6%),0 24px 48px -24px rgb(14 39 102 / 28%);color:#0d1a3a}.ds-panel h3{font-family:'Young Serif',Georgia,serif;font-weight:400;font-size:30px;line-height:1.05;margin:0}.ds-panel p{font-family:'Figtree',system-ui,sans-serif;color:#4a5a7a;margin:8px 0 0}"
    },
    {
      "name": "Cloth Nav",
      "kind": "nav",
      "refersTo": "cloth-field",
      "description": "Top bar on indigo cloth: brand, links, one small gold Reserve.",
      "html": "<header class=\"ds-nav\"><span class=\"ds-wm\">Just Pray</span><nav><a aria-current=\"page\">About</a><a>Next gathering</a><a>Support</a></nav><button class=\"ds-nav-btn\">Reserve a seat</button></header>",
      "css": ".ds-nav{display:flex;align-items:center;gap:26px;height:76px;padding:0 24px;background:#0e2766;color:#fff;border-radius:14px}.ds-wm{font-family:'Young Serif',Georgia,serif;font-size:22px}.ds-nav nav{display:flex;gap:22px;margin-left:auto}.ds-nav a{font-family:'Figtree',system-ui,sans-serif;color:#c5d6f2;font-size:15px;cursor:pointer}.ds-nav a:hover,.ds-nav a[aria-current]{color:#fff}.ds-nav a[aria-current]{text-decoration:underline;text-underline-offset:9px;text-decoration-thickness:2px}.ds-nav-btn{min-height:44px;padding:0 16px;border:0;border-radius:11px;background:#f5b841;color:#3a2600;font-family:'Figtree',system-ui,sans-serif;font-weight:600;font-size:15px}"
    },
    {
      "name": "Photo Tag",
      "kind": "chip",
      "refersTo": "photo-tag",
      "description": "White stitched tag floating over a photo with the next date.",
      "html": "<div class=\"ds-tag\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\"><rect x=\"3.5\" y=\"5\" width=\"17\" height=\"15.5\" rx=\"2\"/><path d=\"M3.5 10h17M8 3v4M16 3v4\"/></svg><div><b>Sat 30 January</b><span>4:00 PM WAT · Lagos</span></div></div>",
      "css": ".ds-tag{position:relative;display:inline-flex;align-items:center;gap:10px;padding:12px 16px;border-radius:14px;background:#fff;color:#0d1a3a;box-shadow:0 18px 36px -18px rgb(0 0 0 / 55%)}.ds-tag::after{content:'';position:absolute;inset:4px;border:1.5px dashed rgb(14 39 102 / 20%);border-radius:11px;pointer-events:none}.ds-tag svg{color:#0e2766}.ds-tag b{display:block;font-family:'Young Serif',Georgia,serif;font-weight:400;font-size:20px;line-height:1.15}.ds-tag span{font-family:'Figtree',system-ui,sans-serif;font-size:14px;color:#4a5a7a}"
    },
    {
      "name": "Seat Cloth",
      "kind": "custom",
      "refersTo": "seat-light-lit",
      "description": "One ring per seat; reserved seats light gold in order, once.",
      "html": "<div class=\"ds-seats\"><i class=\"lit\" style=\"--i:0\"></i><i class=\"lit\" style=\"--i:1\"></i><i class=\"lit\" style=\"--i:2\"></i><i class=\"lit\" style=\"--i:3\"></i><i class=\"lit\" style=\"--i:4\"></i><i class=\"lit\" style=\"--i:5\"></i><i class=\"lit\" style=\"--i:6\"></i><i class=\"lit\" style=\"--i:7\"></i><i class=\"lit\" style=\"--i:8\"></i><i class=\"lit\" style=\"--i:9\"></i><i class=\"lit\" style=\"--i:10\"></i><i class=\"lit\" style=\"--i:11\"></i><i class=\"lit\" style=\"--i:12\"></i><i class=\"lit\" style=\"--i:13\"></i><i class=\"lit mine\" style=\"--i:14\"></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>",
      "css": ".ds-seats{display:grid;grid-template-columns:repeat(12,1fr);gap:16px 10px;justify-items:center;padding:28px;background:#0e2766;border-radius:22px}.ds-seats i{width:18px;height:18px;border-radius:50%;box-shadow:inset 0 0 0 1.5px rgb(255 255 255 / 50%)}.ds-seats i.lit{background:#f5b841;box-shadow:0 0 12px rgb(245 184 65 / 45%);animation:ds-light .42s cubic-bezier(.2,.8,.2,1) both;animation-delay:calc(var(--i) * 14ms)}.ds-seats i.mine{outline:2px solid #f5b841;outline-offset:4px}@keyframes ds-light{from{opacity:0;transform:scale(.4)}}@media (prefers-reduced-motion:reduce){.ds-seats i{animation:none!important}}"
