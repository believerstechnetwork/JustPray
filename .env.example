# Copy the values into Netlify: Site configuration -> Environment variables.
# Never commit real values. Marked (secret) means tick "Contains secret values" in Netlify.

# Database (Supabase -> Project Settings -> Data API / API Keys)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # (secret) the sb_secret_... key or the legacy service_role key

# Organiser page (#/admin)
ADMIN_PASSWORD=                       # (secret) long and hard to guess

# Confirmation emails through Gmail (Google Account -> Security -> App passwords)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=                   # (secret)
EMAIL_FROM_NAME=Just Pray
# EMAIL_REPLY_TO=someone@example.com  # optional, defaults to GMAIL_USER

# Or Resend, once a domain is verified there (takes priority over Gmail when both are set)
# RESEND_API_KEY=                     # (secret)
# EMAIL_FROM=Just Pray <hello@mail.example.org>

# Naira account shown on the Support page
BANK_NAME_NAIRA=
BANK_ACCOUNT_NAME_NAIRA=
BANK_ACCOUNT_NUMBER_NAIRA=

# Dollar account (optional; the currency switch appears when both accounts are set)
BANK_NAME_DOLLAR=
BANK_ACCOUNT_NAME_DOLLAR=
BANK_ACCOUNT_NUMBER_DOLLAR=
# BANK_SWIFT_CODE_DOLLAR=             # optional, for international transfers

# Optional: address used in share links and emails. Emails default to the live site
# (https://justprayy.netlify.app), also from deploy previews, which share the live database.
# VITE_SITE_URL=https://justprayy.netlify.app
# SITE_URL=https://justprayy.netlify.app
